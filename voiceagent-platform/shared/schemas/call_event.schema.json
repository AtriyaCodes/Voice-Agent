{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CallEvent",
  "description": "Event emitted to the analytics/monitoring stream for every significant point in a call's lifecycle.",
  "type": "object",
  "required": ["channelId", "tenantId", "eventType", "timestamp"],
  "properties": {
    "channelId": { "type": "string" },
    "tenantId": { "type": "string" },
    "eventType": {
      "type": "string",
      "enum": [
        "call_started",
        "disclosure_acknowledged",
        "utterance_finalized",
        "tool_invoked",
        "degraded",
        "call_ended",
        "call_failed"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
